generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  urls      Url[]
  apiKeys   ApiKey[]
  folders   Folder[]
  tags      Tag[]
  bioPage   BioPage?
}

model Url {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  originalUrl String
  shortCode   String      @unique
  customAlias String?     @unique
  clicks      Int         @default(0)
  expiresAt   DateTime?
  password    String?
  isDisabled  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  folderId    String?
  folder      Folder?     @relation(fields: [folderId], references: [id])
  tags        Tag[]
  ClickLogs   ClickLog[]
  iosUrl      String?
  androidUrl  String?
  geoRouting  String?     // Stored as JSON string map of country codes to URLs
}

model ClickLog {
  id        String   @id @default(uuid())
  urlId     String
  url       Url      @relation(fields: [urlId], references: [id])
  browser   String?
  device    String?
  country   String?
  state     String?
  city      String?
  ip        String?
  referrer  String?
  timestamp DateTime @default(now())
}

model ApiKey {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  key       String    @unique
  name      String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model Folder {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime @default(now())
  urls      Url[]
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  color     String   @default("#818cf8")
  urls      Url[]
}

model BioPage {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  username    String   @unique
  title       String
  description String?
  theme       String   @default("dark") // dark, light, glass, minimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  links       BioLink[]
}

model BioLink {
  id        String   @id @default(uuid())
  bioPageId String
  bioPage   BioPage  @relation(fields: [bioPageId], references: [id])
  title     String
  url       String
  icon      String?
  order     Int      @default(0)
}
